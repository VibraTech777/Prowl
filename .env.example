# Prowl — API Keys
# Copy to .env and fill in your values.
# Sources without a key are skipped automatically.

# GitHub personal access token — strongly recommended.
# Raises rate limit from 60 to 5 000 req/h and improves GitLeak results.
# No scopes needed (public data only). Fine-grained token with no permissions works.
GITHUB_TOKEN=

# Hunter.io API key — phase-1 employee email search (no account = skipped).
HUNTER_API_KEY=

# Pappers API key — French company data (requires --french --siren).
PAPPERS_API_KEY=

# OpenCorporates API token — required (unauthenticated calls are refused).
OPENCORPORATES_API_TOKEN=
